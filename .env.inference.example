# Copy to .env.inference on your own Docker host. Never commit real credentials.
GLADOS_DEFAULT_MODE=real
MUZEBOS_WORKER_ENABLED=1
MUZEBOS_META_DRY_RUN=1
# Optional providers. Every draft still needs exact-payload approval.
META_MODEL_API_KEY=
BASETEN_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# With docker compose --profile local-model: set this URL and install a model separately.
MUZEBOS_OLLAMA_URL=
MUZEBOS_OLLAMA_MODEL=
