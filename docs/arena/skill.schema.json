{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "tags": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
      }
    },
    "approval": {
      "type": "string",
      "const": "jev-exact-hash"
    },
    "tools": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "inference.draft"
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "steps": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "draft",
              "analysis",
              "plan",
              "code"
            ]
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "lane": {
            "type": "string",
            "enum": [
              "browser",
              "ollama"
            ]
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 32,
            "maximum": 512
          }
        },
        "required": [
          "name",
          "kind",
          "instructions",
          "lane",
          "maxTokens"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "tags",
    "approval",
    "tools",
    "steps"
  ],
  "additionalProperties": false
}
