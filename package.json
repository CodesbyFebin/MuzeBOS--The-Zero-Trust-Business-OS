{
  "name": "metabos",
  "version": "0.1.1",
  "private": true,
  "description": "Self-hostable business OS with SQLite invoicing, inventory, CRM, approval-gated AI tasks and audit evidence",
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "preview": "node scripts/serve.mjs preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "seed:demo-story": "tsx scripts/seed-demo-story.ts",
    "brain:docs": "tsx scripts/generate-brain-docs.ts",
    "adscout": "tsx scripts/adscout.ts",
    "lab-sync": "tsx scripts/lab-sync.ts",
    "lab-agent": "tsx scripts/lab-agent.ts",
    "lab-e2e": "tsx scripts/lab-e2e-dry.ts",
    "test:browser": "node scripts/metabos-browser.mjs",
    "test:mission-browser": "node scripts/metabos-mission-browser.mjs",
    "test:integrations-browser": "node scripts/metabos-integrations-browser.mjs",
    "test:qualify-browser": "node scripts/metabos-qualify-browser.mjs",
    "inference:worker": "tsx scripts/inference-worker.ts",
    "inference:once": "tsx scripts/inference-worker.ts --once",
    "inference:bootstrap": "tsx scripts/inference-bootstrap.ts",
    "test:slice2-browser": "node scripts/metabos-slice2-browser.mjs",
    "test:slice3-browser": "node scripts/metabos-slice3-browser.mjs",
    "test:slice4-browser": "node scripts/metabos-slice4-browser.mjs",
    "test:slice5-browser": "node scripts/metabos-slice5-browser.mjs",
    "test:slice7-browser": "node scripts/metabos-slice7-browser.mjs",
    "test:slice9-browser": "node scripts/metabos-slice9-browser.mjs",
    "test:slice8-browser": "node scripts/metabos-modules-browser.mjs",
    "docs:build": "node scripts/build-project-site.mjs",
    "repo:metadata": "node scripts/update-repository-metadata.mjs",
    "hackathon:demo": "node --import tsx scripts/hackathon-demo.ts",
    "demo:agent": "node --import tsx scripts/hackathon-demo.ts"
  },
  "dependencies": {
    "@miosa/sdk": "^3.2.5",
    "@mlc-ai/web-llm": "^0.2.86",
    "@notionhq/client": "^5.22.0",
    "@slack/web-api": "^7.16.0",
    "@types/d3-force": "^3.0.10",
    "ai": "^6.0.317",
    "better-sqlite3": "^11.3.0",
    "d3-force": "^3.0.0",
    "imapflow": "^1.4.0",
    "lucide-react": "^0.441.0",
    "next": "^15.5.28",
    "node-ical": "^0.26.1",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.27.0",
    "stripe": "^22.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "playwright": "1.58.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "keywords": [
    "self-hosted",
    "business-os",
    "invoicing",
    "inventory",
    "crm",
    "webllm",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodesbyFebin/MuzeBOS--The-Zero-Trust-Business-OS.git"
  },
  "bugs": {
    "url": "https://github.com/CodesbyFebin/MuzeBOS--The-Zero-Trust-Business-OS/issues"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
