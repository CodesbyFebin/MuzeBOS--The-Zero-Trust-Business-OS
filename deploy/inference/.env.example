# Never commit the filled .env.inference file or paste keys into chats.
GLADOS_DEFAULT_MODE=real
GLADOS_WARM=0
GLADOS_CRON=0
MUZEBOS_WORKER_ENABLED=1
MUZEBOS_INFERENCE_PAID=0
# Include /v1. Use localhost when running natively, ollama on Compose.
MUZEBOS_OLLAMA_URL=http://ollama:11434/v1
MUZEBOS_OLLAMA_MODEL=llama3.2:3b
# Optional external providers. Paid routes require server opt-in + task consent.
MODEL_API_KEY=
OPENROUTER_API_KEY=
MUZEBOS_OPENROUTER_MODEL=
